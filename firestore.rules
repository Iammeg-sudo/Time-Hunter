rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者：admins 集合中「文件 ID = 管理者 email（小寫）」的文件
    // 最高管理者：該文件多一個欄位 super = true
    function me() { return request.auth.token.email.lower(); }
    function isAdmin() {
      return request.auth != null && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admins/$(me()));
    }
    function isSuper() {
      return isAdmin() && get(/databases/$(database)/documents/admins/$(me())).data.get('super', false) == true;
    }
    function survey(sid) {
      return get(/databases/$(database)/documents/surveys/$(sid)).data;
    }
    // 建立者或最高管理者才能管理（檢視名單 email、修改、刪除）一場調查
    function canManage(sid) {
      return isAdmin() && (survey(sid).get('createdBy', '') == me() || isSuper());
    }

    match /admins/{email} {
      allow get: if request.auth != null && (me() == email || isAdmin());
      allow list: if isAdmin();
      // 只有最高管理者能管理名單；不能移除自己、也不能取消自己的最高管理者身分
      allow create: if isSuper();
      allow update: if isSuper() && (email != me() || request.resource.data.get('super', false) == true);
      allow delete: if isSuper() && email != me();
    }

    // 與會名單：建立者與最高管理者可看可改；被分享的人（全部或指定）只能看
    match /lists/{id} {
      allow read: if isSuper() || (isAdmin() && (
        resource.data.owner == me()
        || resource.data.shareAll == true
        || me() in resource.data.sharedWith
      ));
      allow create: if isAdmin() && request.resource.data.owner == me();
      allow update: if isAdmin() && (resource.data.get('owner', '') == me() || isSuper())
        && request.resource.data.owner == resource.data.get('owner', request.resource.data.owner);  // 建立者不能被改掉
      allow delete: if isAdmin() && (resource.data.get('owner', '') == me() || isSuper());
    }

    match /surveys/{sid} {
      allow get: if true;                 // 有連結的人可看該場調查（前台填寫用）
      // 總覽：一般管理者只能列出自己建立的；最高管理者可列出全部
      allow list: if isSuper() || (isAdmin() && resource.data.createdBy == me());
      allow create: if isAdmin() && request.resource.data.createdBy == me();
      allow update: if isAdmin() && (resource.data.get('createdBy', '') == me() || isSuper())
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');  // 建立者不能被改掉
      allow delete: if isAdmin() && (resource.data.get('createdBy', '') == me() || isSuper());

      match /private/{doc} {              // 與會者 email 只有建立者與最高管理者看得到
        allow read, write: if canManage(sid);
      }

      match /responses/{pid} {
        allow read: if true;
        allow delete: if canManage(sid);
        allow create, update: if canManage(sid) || (
          survey(sid).status == 'open'
          && request.time.toMillis() < survey(sid).deadline
          && pid in survey(sid).pids
          && request.resource.data.keys().hasOnly(['pid', 'name', 'slots', 'updatedAt'])
          && request.resource.data.pid == pid
          && request.resource.data.slots is list
          && request.resource.data.slots.size() <= 200
        );
      }
    }
  }
}
